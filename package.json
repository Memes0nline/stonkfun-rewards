{
  "name": "stonkfun-rewards",
  "version": "1.0.0",
  "description": "Finds the StonkFun holder payouts a Solana wallet received and shows them in a local dashboard.",
  "author": "memeologist99",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Memes0nline/stonkfun-rewards.git"
  },
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.4",
  "engines": {
    "node": ">=24.15",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "rewards": "pnpm --silent build && node dist/cli/main.js",
    "test": "pnpm --silent build && vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm --silent build && tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "check": "pnpm test && pnpm typecheck && pnpm lint",
    "build:web": "pnpm build && vite build",
    "rewards:web": "node scripts/start-dashboard.mjs",
    "test:browser": "pnpm build:web && playwright test"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
